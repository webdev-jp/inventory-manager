<Project>
  <!--
    ClickOnce publish profile - distributes Inventory Manager from a shared network folder so
    admins install once and get prompted to update automatically on every launch (checked before
    the app runs, per UpdateMode below), instead of IT copying a new build to every machine by
    hand. Requires running via the FULL-FRAMEWORK MSBuild.exe (from Visual Studio/Build Tools),
    not `dotnet publish` - the ClickOnce manifest tasks (GenerateApplicationManifest,
    UpdateManifest, etc.) explicitly refuse to run under the cross-platform .NET Core MSBuild
    engine ("MSB4803: ... not supported on the .NET Core version of MSBuild").

    To publish a new version, bump ApplicationRevision (or ApplicationVersion for a real version
    bump) below, then from an elevated-not-required, ordinary prompt:

      "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\amd64\MSBuild.exe" ^
        InventoryManager.App.csproj -t:Publish -p:Configuration=Release -p:PublishProfile=ClickOnce

    Requires the "Contoso IT Scripts" self-signed code-signing certificate (the same one used for
    Offboarding2026.ps1) to be present with its private key in LocalMachine\My on whichever
    machine runs the publish - confirmed present there as of 2026-09-16
    (thumbprint 0000000000000000000000000000000000000000). Every admin machine that installs this
    app must trust that same certificate (already true - it was distributed for the offboarding
    script's own signing requirement earlier), or ClickOnce will refuse to install/update.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>\\fileserver01\IT-Apps\InventoryApp\</PublishDir>
    <PublishUrl>\\fileserver01\IT-Apps\InventoryApp\</PublishUrl>
    <InstallUrl>\\fileserver01\IT-Apps\InventoryApp\</InstallUrl>

    <Install>true</Install>
    <InstallFrom>Unc</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <!-- v1.0.3.0/1.0.3.1 forced this update (UpdateRequired=true + MinimumRequiredVersion) because
         they contained the 2026-09-16 login-gate/SU-login authentication bypass fix (see
         feedback_ad_password_validation_bug memory) - every install is now at or past that fix,
         so this and future routine releases go back to the normal optional-but-prompted update
         (UpdateEnabled + UpdateMode=Foreground still checks and prompts on every launch; nobody
         can silently stay on an old build without at least seeing the prompt). Reintroduce
         UpdateRequired + MinimumRequiredVersion the same way if a future fix is this critical
         again. -->
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>false</MapFileExtensions>

    <ApplicationVersion>1.0.29.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <ProductName>Inventory Manager</ProductName>
    <PublisherName>Contoso Ltd</PublisherName>

    <SignManifests>true</SignManifests>
    <ManifestCertificateThumbprint>0000000000000000000000000000000000000000</ManifestCertificateThumbprint>
    <GenerateManifests>true</GenerateManifests>

  </PropertyGroup>
</Project>
